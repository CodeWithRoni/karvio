{
  "name": "shop-erp",
  "private": true,
  "version": "1.0.2",
  "author": "ShopERP",
  "description": "Shop Management & POS for computer / IT / networking retail — React frontend for the Google Apps Script backend",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:build": "npm run icons && vite build && electron-builder --publish never",
    "desktop:build:win": "npm run icons && vite build && electron-builder --win nsis --x64 --publish never",
    "desktop:build:mac": "npm run icons && vite build && electron-builder --mac dmg --publish never",
    "tauri": "tauri",
    "tauri:build": "npm run icons && tauri build",
    "icons": "tauri icon public/app-icon.svg",
    "test": "node ../backend/test/simulate.js && node ../backend/test/valuation.js && node ../backend/test/categories.cjs",
    "test:e2e": "playwright test",
    "verify:live": "node ../backend/test/live.cjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.shoperp.app",
    "productName": "ShopERP",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "src-tauri/icons/icon.icns",
      "category": "public.app-category.business"
    },
    "directories": {
      "output": "release"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
