{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karvio",
  "version": "1.2.1",
  "identifier": "com.karvio.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Karvio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../branding/linux/32x32.png",
      "../branding/linux/128x128.png",
      "../branding/macos/icon.icns",
      "../branding/windows/icon.ico"
    ]
  }
}
