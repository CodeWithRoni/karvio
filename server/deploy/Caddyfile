# /etc/caddy/Caddyfile — HTTPS for www.karvioerp.com and every <shop>.karvioerp.com.
# Certificates come from Let's Encrypt automatically. A shop's certificate is requested the first
# time someone opens its address, and only if the Karvio server says the shop exists.
{
	email {$KARVIO_ADMIN_EMAIL}
	on_demand_tls {
		ask http://127.0.0.1:8787/internal/tls-allowed
	}
}

# The main site.
karvioerp.com {
	redir https://www.karvioerp.com{uri} permanent
}
www.karvioerp.com {
	root * /srv/karvio/site
	encode zstd gzip
	file_server
}

# Every shop: the same web app, and /api goes to that shop's own database through the Karvio server.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /api* {
		reverse_proxy 127.0.0.1:8787 {
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
	handle /internal/* {
		respond 404
	}
	handle {
		root * /srv/karvio/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
